# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Secrets and local config (the .env.example template IS committed)
.env
.env.*
!.env.example

# NLTK data downloaded into the project (normally stored in ~/nltk_data)
nltk_data/

# Large external datasets (e.g. ESCO exports) - keep the folders, not the files
backend/data/esco/*
!backend/data/esco/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
