# Leave VITE_API_URL empty in development: requests go to /api and the Vite
# dev server proxies them to Flask (see VITE_PROXY_TARGET).
# For a production build served from another origin, set the full backend URL
# (and allow that origin in the backend with CORS_ORIGINS), e.g.
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# Where the dev server forwards /api requests
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Client-side PDF size check in MB. Keep equal to MAX_UPLOAD_MB in the backend .env
VITE_MAX_UPLOAD_MB=5
