# Copy this file to ".env" (in the project root) and fill in your own values.
# ".env" is ignored by Git. Never commit real passwords.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=resumeiq
DB_USER=resumeiq_user
DB_PASSWORD=replace_with_your_password

# Largest accepted PDF upload, in megabytes
MAX_UPLOAD_MB=5

# Flask development server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Optional: allow a frontend served from another origin to call the API
# (comma-separated). Not needed in development, where Vite proxies /api.
# CORS_ORIGINS=http://localhost:5173
